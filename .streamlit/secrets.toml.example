# Plantilla de configuración de conexión.
#
# COPIAR este archivo como  .streamlit/secrets.toml  y reemplazar la
# contraseña por la de PostgreSQL de cada computadora.
#
# IMPORTANTE: secrets.toml NO se sube al repositorio (está en .gitignore).
# Este archivo .example SÍ se sube, porque no contiene credenciales.

[postgres]
host = "localhost"
port = "5432"
database = "proyecto_sicop_v1"
user = "postgres"
password = "REEMPLAZAR_CON_TU_CONTRASEÑA"
